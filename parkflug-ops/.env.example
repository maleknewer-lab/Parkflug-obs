# Neon: direct (non-pooled) connection string — used by prisma migrate
DIRECT_URL=

# Auth.js (added in step 3)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Later phases
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
