// Step 1 only: connection setup + one placeholder model so the first migration works.
// The full core model (Brand, Rate, PriceTable, Booking, ...) comes in the next step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Brand {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g. "parkflug", "dus-valet"
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
